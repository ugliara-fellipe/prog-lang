// Executable reference algorithms over literal List[Int] inputs.
// `std` is imported explicitly; the runtime supplies only std.* primitives.
import std

// Worst case: O(N). The first argument decreases structurally; `target` is
// a carried value and therefore does not participate in the termination proof.
func linear_search(items: List[Int], target: Int) -> Bool {
    match items {
        Nil => False,
        Cons(head, tail) => {
            match std.equals(head, target) {
                True => True,
                False => linear_search(tail, target)
            }
        }
    }
}

// Worst case: O(N). A reference implementation returns the largest element.
func max_value(items: List[Int]) -> Int {
    match items {
        Nil => 0,
        Cons(head, tail) => std.max(head, max_value(tail))
    }
}

// Inserting an item scans a sorted prefix: O(N).
func insert_sorted(items: List[Int], value: Int) -> List[Int] {
    match items {
        Nil => std.prepend(value, std.empty()),
        Cons(head, tail) => {
            match std.less_or_equal(value, head) {
                True => std.prepend(value, items),
                False => std.prepend(head, insert_sorted(tail, value))
            }
        }
    }
}

// Insertion sort is O(N²) in the worst case: each recursive insertion can
// traverse the already-sorted prefix.
func insertion_sort(items: List[Int]) -> List[Int] {
    match items {
        Nil => std.empty(),
        Cons(head, tail) => insert_sorted(insertion_sort(tail), head)
    }
}

// `main` makes the fixture runnable. Each result is evaluated by calling the
// functions declared above; no algorithm is special-cased by the runtime.
routine main() {
    std.log("linear search for 7:", linear_search([9, 2, 7, 1], 7))
    std.log("linear search for 8:", linear_search([9, 2, 7, 1], 8))
    std.log("maximum:", max_value([9, 2, 7, 1]))
    std.log("insertion sort:", insertion_sort([9, 2, 7, 1]))
}
