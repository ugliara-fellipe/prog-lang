// ============================================================
import std
// 02_bounded_loops.proglang
// Feature Coverage:
// - Strictly bounded repetition loops ('for ... in')
// - Finite termination guarantee: absence of unbounded loops (no 'while')
// - Iteration over known finite immutable collections
// - Statement execution within loop body
// ============================================================

type BatchData {
    id: Int,
    items: List[Int]
}

routine ProcessBatch(batch: BatchData) {
    let mut total_processed: Ref[Int] = ref 0
    
    for item in batch.items {
        std.log("Processing batch item:", item)
    }

    for other in batch.items {
        std.log("Checking item consistency:", other)
    }
}
