// ============================================================
import std
// 00_hello_world.lia
// Hello World Program in Lia
//
// Features demonstrated:
// - Pure function returning String
// - Isolated routine ('routine HelloWorld()')
// - Fast O(1) memory allocation on routine Arena
// - Terminal logging via explicitly imported std.log(...)
// - Instant O(1) Arena deallocation on routine exit
// ============================================================

func get_message() -> String {
    "Hello, World!"
}

routine HelloWorld() {
    // Local allocation in routine Arena (Zero GC)
    let ref_msg: Ref[String] = ref get_message()

    // Terminal print
    std.log("Hello, World!")
}

// This tutorial is executable; only `main` starts automatically.
routine main() {
    spawn HelloWorld()
}
