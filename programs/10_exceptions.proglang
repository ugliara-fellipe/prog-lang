// Functions may emit and catch exceptions. Routines and loops may catch
// exceptions emitted by functions, but cannot throw directly.
import std

func may_fail(value: Int) -> Int {
    try {
        throw "invalid value"
    } catch error {
        std.log("function caught:", error)
    }
    value
}

routine Worker(value: Int) {
    try {
        may_fail(value)
    } catch error {
        std.log("routine caught:", error)
    }
}

routine StartMonitor() {
    spawn Monitor()
}

loop Monitor() {
    try {
        may_fail(0)
    } catch error {
        std.log("loop caught:", error)
    }
    terminate
}

routine main() {
    std.log("starting exception monitor")
    spawn StartMonitor()
}
